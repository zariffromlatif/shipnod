# --- Server ---
NODE_ENV=development
PORT=8787
# Public URL customers open from the confirmation SMS. Use a SHORT domain in production (Bangla SMS = 70 chars/segment).
PUBLIC_BASE_URL=http://localhost:8787

# --- Storage ---
DATABASE_PATH=./data/shipnod.db

# --- Secrets (REQUIRED in production; generate with: openssl rand -hex 32) ---
# HMAC key used to hash phone numbers in the shared cross-seller network. Never rotate casually: it re-keys all network data.
NETWORK_HASH_SECRET=
# 32-byte key (64 hex chars) used to encrypt courier credentials at rest (AES-256-GCM).
APP_ENCRYPTION_KEY=

# --- SMS ---
# console = print to stdout (dev). http = call a Bangladeshi SMS gateway via URL template.
SMS_PROVIDER=console
# Placeholders: {apiKey} {senderId} {to} {text}. Values are URL-encoded. Example (verify with your gateway's docs):
# SMS_HTTP_URL=https://bulksmsbd.net/api/smsapi?api_key={apiKey}&type=text&number={to}&senderid={senderId}&message={text}
SMS_HTTP_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Couriers ---
# true = use the Pathao / RedX sandbox hosts. Steadfast always uses its live URL — test with a real merchant account.
COURIER_SANDBOX=true
STATUS_SYNC_INTERVAL_MINUTES=30

# --- Confirmation ---
CONFIRM_TTL_HOURS=48

# --- Billing ---
# SSLCommerz merchant (one checkout for bKash, Nagad, Rocket, cards). Leave empty to hide online payment.
# Sandbox store: register at https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Your bKash / Nagad numbers for manual "Send Money" payments (approved in /admin). Empty = hidden.
BILLING_BKASH_NUMBER=
BILLING_NAGAD_NUMBER=

# --- Admin ---
# Enables /admin (approve manual payments, grant plans, MRR). At least 12 characters; empty = admin disabled.
ADMIN_PASSWORD=
