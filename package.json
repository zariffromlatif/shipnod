{
  "name": "shipnod",
  "version": "0.1.0",
  "private": true,
  "description": "COD order confirmation, fraud-risk scoring and multi-courier automation for Bangladeshi online sellers.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seller:create": "tsx --disable-warning=ExperimentalWarning src/cli/create-seller.ts",
    "seed:demo": "tsx --disable-warning=ExperimentalWarning scripts/seed-demo.ts",
    "sms:test": "tsx --disable-warning=ExperimentalWarning src/cli/sms-test.ts",
    "db:snapshot": "tsx --disable-warning=ExperimentalWarning src/cli/snapshot.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
