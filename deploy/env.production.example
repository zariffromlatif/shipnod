# Production settings for docker compose. Copy to .env in the repo root:  cp deploy/env.production.example .env
# Never commit .env. Generate each secret with:  openssl rand -hex 32

# --- Domain -----------------------------------------------------------------------------------------
# The domain Caddy serves (DNS A record must point at this server). Keep it SHORT: it is in every SMS link.
DOMAIN=shipnod.example
PUBLIC_BASE_URL=https://shipnod.example

# --- Secrets (required) -------------------------------------------------------------------------------
NETWORK_HASH_SECRET=
APP_ENCRYPTION_KEY=
# Enables /admin. At least 12 characters — use a long random one and keep it in a password manager.
ADMIN_PASSWORD=

# --- SMS gateway (required in production) ----------------------------------------------------------------
SMS_PROVIDER=http
# Placeholders: {apiKey} {senderId} {to}=8801XXXXXXXXX {toLocal}=01XXXXXXXXX {text} {type}=text|unicode {unicode}=0|1
# Copy the exact format from your gateway's API docs. BulkSMSBD-style example (verify before use):
SMS_HTTP_URL=https://bulksmsbd.net/api/smsapi?api_key={apiKey}&type={type}&number={to}&senderid={senderId}&message={text}
SMS_API_KEY=
SMS_SENDER_ID=
# Regex the gateway's response must match to count as sent (many gateways answer HTTP 200 on errors).
SMS_HTTP_SUCCESS_PATTERN=response_code\D{1,5}202

# --- Couriers -----------------------------------------------------------------------------------------
# false = live Pathao/RedX APIs. Use true only while testing with sandbox credentials.
COURIER_SANDBOX=false
STATUS_SYNC_INTERVAL_MINUTES=30
CONFIRM_TTL_HOURS=48

# --- Billing -------------------------------------------------------------------------------------------
# Your own bKash / Nagad numbers for manual Send Money (approve in /admin). Empty = hidden.
BILLING_BKASH_NUMBER=
BILLING_NAGAD_NUMBER=
# SSLCommerz merchant credentials (leave empty until approved). Keep SANDBOX=true with a sandbox store.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=false

# --- Backups (required) — S3-compatible bucket for Litestream ------------------------------------------
# Cloudflare R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto
# Backblaze B2:  endpoint https://s3.<region>.backblazeb2.com (e.g. s3.us-west-004.backblazeb2.com), region = that region
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true

# --- Pilot requests (landing page form) ---
# Your phone: texted when a seller asks for a pilot (max 20 SMS/day). Empty = no SMS, see /admin/leads.
LEAD_ALERT_PHONE=
# Number behind the landing page's "WhatsApp-এ কথা বলুন" button. Empty = button hidden.
SUPPORT_WHATSAPP=
